# Normal, lalu flash sale, lalu turun pelan sampai normal lagi.
# 0–120 dtk: 10 RPS. 120–180: 400 RPS. 180–540: 400 → 10. 540–600: 10 RPS.
# WORKERS = BURST_RPS * timeout (5 dtk) supaya antrean tidak mentok di generator.
PROFILE=burst-flash-sale
DURATION=600
BASE_RPS=10
BURST_RPS=400
BURST_START=120
BURST_DURATION=60
DECAY_DURATION=360
WORKERS=2000
